{
    "name": "pecans-spec",
    "version": "1.0.0",
    "description": "TypeSpec source of truth + SDK generator for the Two Cans & String API",
    "private": true,
    "type": "module",
    "license": "GPL-3.0-only",
    "scripts": {
        "compile": "tsp compile .",
        "watch": "tsp compile . --watch",
        "generate": "tsp compile . && bun run src/generate-ts.ts",
        "clean": "rm -rf dist || true"
    },
    "devDependencies": {
        "@types/node": "^20.8.4",
        "@typespec/compiler": "^1.6.0",
        "@typespec/json-schema": "^1.6.0",
        "json-schema-to-typescript": "^15.0.4",
        "typescript": "^5.6.0"
    }
}
